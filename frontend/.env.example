# ─── Identity provider ────────────────────────────────────────────────────
# Public URL of the mks-identity service.
# The frontend calls this directly for login / register / refresh / logout.
VITE_IDENTITY_URL=http://localhost:3030

# ─── Kanban backend ───────────────────────────────────────────────────────
# Overrides the default /api/v1 proxy target in production.
# Leave unset in dev — Vite proxies /api to localhost:3100 automatically.
# VITE_API_URL=http://localhost:3100

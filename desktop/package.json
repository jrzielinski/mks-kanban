{
  "name": "mks-kanban-desktop",
  "version": "0.1.0",
  "description": "MKS Kanban — Electron desktop app",
  "private": true,
  "main": "dist/main.js",
  "exports": {
    ".":               { "types": "./dist/main.d.ts",           "default": "./dist/main.js" },
    "./authStore":     { "types": "./dist/authStore.d.ts",      "default": "./dist/authStore.js" },
    "./backendProcess":{ "types": "./dist/backendProcess.d.ts", "default": "./dist/backendProcess.js" },
    "./boardLibrary":  { "types": "./dist/boardLibrary.d.ts",   "default": "./dist/boardLibrary.js" },
    "./desktopSecret": { "types": "./dist/desktopSecret.d.ts",  "default": "./dist/desktopSecret.js" },
    "./preload":       { "default": "./dist/preload.js" },
    "./updater":       { "types": "./dist/updater.d.ts",        "default": "./dist/updater.js" },
    "./windowState":   { "types": "./dist/windowState.d.ts",    "default": "./dist/windowState.js" }
  },
  "typesVersions": {
    "*": {
      "authStore":      ["dist/authStore.d.ts"],
      "backendProcess": ["dist/backendProcess.d.ts"],
      "boardLibrary":   ["dist/boardLibrary.d.ts"],
      "desktopSecret":  ["dist/desktopSecret.d.ts"],
      "updater":        ["dist/updater.d.ts"],
      "windowState":    ["dist/windowState.d.ts"]
    }
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "npm run build --prefix ../frontend",
    "build:backend": "npm run build --prefix ../backend",
    "build": "npm run build:renderer && npm run build:backend && npm run build:main && npm run build:mks-code && npm run rebuild:native",
    "build:mks-code": "npm run build --prefix ../mks-code",
    "rebuild:native": "electron-rebuild && electron-rebuild --module-dir ../backend && electron-rebuild --module-dir ../mks-code",
    "rebuild:backend-native": "electron-rebuild --module-dir ../backend",
    "pack": "bash scripts/pack-kanban.sh",
    "pack:dir": "bash scripts/pack-kanban.sh && electron-builder --dir --config electron-builder.json",
    "dev": "npm run build && electron --no-sandbox .",
    "fix:pty-perms": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "postinstall": "electron-builder install-app-deps && npm run fix:pty-perms"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.12.0",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.0"
  }
}
